# ═══════════════════════════════════════════════════════════════════════════════
#  PyCodeFlow — .env.example
#  Kopieer dit bestand naar .env en vul de waarden in.
#  NOOIT het .env bestand in git zetten!
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://pycodeflow:JOUW_WACHTWOORD@postgres:5432/pycodeflow
POSTGRES_PASSWORD=JOUW_WACHTWOORD
DB_SSL=false

# ── Runner ────────────────────────────────────────────────────────────────────
RUNNER_URL=http://runner:5000

# ── Authenticatie ─────────────────────────────────────────────────────────────
# 50f: inloggen gaat UITSLUITEND via leerkracht-accounts in de databank.
# Deze twee waarden zijn GEEN login meer. Ze dienen enkel om bij een LEGE databank
# automatisch de eerste leerkracht aan te maken (de "bootstrap" bij het opstarten).
# Daarna log je in met diezelfde naam en dat wachtwoord — maar tegen de databank,
# met een echte sessie die je kan afmelden en intrekken.
# Staat er al een leerkracht in de databank, dan doen deze waarden niets.
#
# Zonder leerkracht én zonder deze waarden start de app NIET (dat is bedoeld:
# een app waar niemand in kan, hoort niet te draaien). Een leerkracht toevoegen kan
# ook als de container stilligt:
#   docker compose run --rm web node scripts/manage-teacher.js add <naam> '<wachtwoord>' admin
POC_BASIC_USER=CHANGE_ME
POC_BASIC_PASS=CHANGE_ME
# 30a: sessieduur leerkracht-login in uren (standaard 8u = schooldag). 0 = tot browser sluit.
POC_SESSION_MAX_AGE_HOURS=8
# 50d: harde bovengrens op een sessie in uren (standaard 24u).
# De duur hierboven schuift mee zolang je werkt, zodat je nooit midden in een les
# buitenvliegt. Deze grens zorgt dat een sessie op een klaslokaal-pc niet maandenlang
# blijft leven door dagelijks gebruik: je logt hooguit één keer per dag opnieuw in.
POC_SESSION_ABSOLUTE_MAX_HOURS=24

# ── Applicatieversie ──────────────────────────────────────────────────────────
APP_VERSION_YEAR=2026
APP_VERSION_MAJOR=2
APP_VERSION_MINOR=34
APP_VERSION_BUILD=4

# ── PDF export ────────────────────────────────────────────────────────────────
SCHOOL_NAME=Atheneum Hoboken
# SCHOOL_LOGO_PATH=/app/public/assets/logo.png

# ── Veiligheid ────────────────────────────────────────────────────────────────
STRESS_TEST_ENABLED=false
# 32b: logniveau (error, warn, info, debug). Standaard info. Zet op debug bij problemen.
LOG_LEVEL=info
# 30d: hoeveel dagen DB-backups bewaard blijven (backups/ map). Standaard 7.
BACKUP_RETENTION_DAYS=7
