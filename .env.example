# =========================
# PyCodeFlow environment
# =========================

# true  = lokaal testen op laptop, zonder Cloudflare Tunnel
# false = servermodus op de UGREEN, met Cloudflare Tunnel
TEST_MODE=true

# Tijdelijke teacher-only basic auth
POC_BASIC_AUTH_ENABLED=true
POC_BASIC_USER=teacher
POC_BASIC_PASS=vervang_dit_met_een_sterk_wachtwoord
POC_BASIC_AUTH_REALM=PyCodeFlow Teacher

# Alleen nodig als TEST_MODE=false
# Maak voor PyCodeFlow een APARTE tunnel in Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# App-versie (wordt getoond in de footer van alle pagina's)
APP_VERSION_YEAR=2026
APP_VERSION_MAJOR=1
APP_VERSION_MINOR=12
APP_VERSION_BUILD=3

# Optioneel
NODE_ENV=production
